      <!-- Group D additions -->
      <SolidColorBrush x:Key="EnyoDialogGroupBackgroundBrush" Color="#59FFFFFF" />
      <!-- Group E additions -->
      <!-- Group F additions -->
      <!-- Group G additions -->
      <SolidColorBrush x:Key="EnyoImageViewBackgroundBrush" Color="#000000" />
      <SolidColorBrush x:Key="EnyoCropScrimBrush" Color="#99000000" />
      <SolidColorBrush x:Key="EnyoCropFrameBrush" Color="#E6FFFFFF" />
      <!-- Group H additions -->
      <!-- Group S additions -->
      <!-- Shadows -->
      <BoxShadows x:Key="EnyoButtonPressedShadow">inset 0 1 5 0 #4D000000</BoxShadows>
      <BoxShadows x:Key="EnyoInputFocusShadow">inset 0 1 3 0 #40000000</BoxShadows>
      <BoxShadows x:Key="EnyoToolInputShadow">inset 0 1 3 0 #59000000</BoxShadows>
      <BoxShadows x:Key="EnyoPopupShadow">0 2 10 0 #59000000</BoxShadows>
      <BoxShadows x:Key="EnyoMenuShadow">0 2 8 0 #59000000</BoxShadows>
      <BoxShadows x:Key="EnyoPillFocusShadow">0 0 8 0 #59000000</BoxShadows>
      <BoxShadows x:Key="EnyoHandleShadow">0 1 3 0 #40000000</BoxShadows>
      <BoxShadows x:Key="EnyoReorderShadow">0 4 12 0 #66000000</BoxShadows>
      <BoxShadows x:Key="EnyoNoShadow">0 0 0 0 #00000000</BoxShadows>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <!-- Surfaces -->
      <SolidColorBrush x:Key="EnyoBodyBrush" Color="{DynamicResource EnyoBodyColor}" />
      <SolidColorBrush x:Key="EnyoTextBrush" Color="{DynamicResource EnyoTextColor}" />
      <SolidColorBrush x:Key="EnyoSubtextBrush" Color="{DynamicResource EnyoSubtextColor}" />
