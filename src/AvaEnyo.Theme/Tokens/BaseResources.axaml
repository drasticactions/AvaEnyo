        <GradientStop Offset="0.9" Color="#14000000" />
        <GradientStop Offset="1" Color="#1FFFFFFF" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="EnyoButtonEdgeBrush" Color="{DynamicResource EnyoFrameEdgeColor}" />
      <LinearGradientBrush x:Key="EnyoButtonPressedSheenBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#40000000" />
        <GradientStop Offset="0.2" Color="#26000000" />
        <GradientStop Offset="1" Color="#1A000000" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="EnyoButtonPressedEdgeBrush" Color="{DynamicResource EnyoFramePressedEdgeColor}" />
      <SolidColorBrush x:Key="EnyoButtonDarkBackgroundBrush" Color="{DynamicResource EnyoDarkButtonColor}" />
      <SolidColorBrush x:Key="EnyoButtonAffirmativeBackgroundBrush" Color="{DynamicResource EnyoAffirmativeColor}" />
      <SolidColorBrush x:Key="EnyoButtonNegativeBackgroundBrush" Color="{DynamicResource EnyoNegativeColor}" />
