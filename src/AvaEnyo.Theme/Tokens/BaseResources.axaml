      <LinearGradientBrush x:Key="EnyoDashboardBackgroundBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#2A2A2A" />
        <GradientStop Offset="1" Color="#0E0E0E" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="EnyoDashboardForegroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="EnyoDashboardSubtextBrush" Color="#9A9A9A" />
      <SolidColorBrush x:Key="EnyoBadgeBackgroundBrush" Color="{DynamicResource EnyoBlueColor}" />
      <!-- Group A additions -->
      <SolidColorBrush x:Key="EnyoProgressItemBackgroundBrush" Color="#14FFFFFF" />
      <!-- Group B additions -->
      <SolidColorBrush x:Key="EnyoMenuItemGestureBrush" Color="#9A9A9A" />
      <SolidColorBrush x:Key="EnyoGridSplitterBrush" Color="#40FFFFFF" />
      <!-- Group C additions -->
      <!-- Group D additions -->
      <SolidColorBrush x:Key="EnyoDialogGroupBackgroundBrush" Color="#14FFFFFF" />
      <!-- Group E additions -->
      <!-- Group F additions -->
      <!-- Group G additions -->
      <SolidColorBrush x:Key="EnyoImageViewBackgroundBrush" Color="#000000" />
      <SolidColorBrush x:Key="EnyoCropScrimBrush" Color="#B3000000" />
      <SolidColorBrush x:Key="EnyoCropFrameBrush" Color="#E6FFFFFF" />
      <!-- Group H additions -->
      <!-- Group S additions -->
      <!-- Shadows -->
      <BoxShadows x:Key="EnyoButtonPressedShadow">inset 0 1 5 0 #80000000</BoxShadows>
      <BoxShadows x:Key="EnyoInputFocusShadow">inset 0 1 3 0 #80000000</BoxShadows>
      <BoxShadows x:Key="EnyoToolInputShadow">inset 0 1 3 0 #80000000</BoxShadows>
      <BoxShadows x:Key="EnyoPopupShadow">0 2 12 0 #A6000000</BoxShadows>
      <BoxShadows x:Key="EnyoMenuShadow">0 2 10 0 #A6000000</BoxShadows>
      <BoxShadows x:Key="EnyoPillFocusShadow">0 0 8 0 #A6000000</BoxShadows>
      <BoxShadows x:Key="EnyoHandleShadow">0 1 3 0 #80000000</BoxShadows>
      <BoxShadows x:Key="EnyoReorderShadow">0 4 14 0 #B3000000</BoxShadows>
      <BoxShadows x:Key="EnyoNoShadow">0 0 0 0 #00000000</BoxShadows>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

