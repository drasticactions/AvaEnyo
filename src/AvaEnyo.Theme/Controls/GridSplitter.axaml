<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Grid Width="300" Height="120" ColumnDefinitions="*,Auto,*">
      <GridSplitter Grid.Column="1" />
    </Grid>
  </Design.PreviewWith>

  <!--
    Invented: a thin grab line with the item edge pair (a dark line beside a light one), like the edge between two
    Enyo panes. The drag preview is the Onyx blue.
  -->
  <ControlTheme x:Key="{x:Type GridSplitter}" TargetType="GridSplitter">
    <Setter Property="Focusable" Value="True" />
    <Setter Property="MinWidth" Value="6" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource EnyoGridSplitterBrush}" />
    <Setter Property="PreviewContent">
      <Template>
        <Rectangle Fill="{DynamicResource EnyoButtonBlueBackgroundBrush}" Opacity="0.6" />
      </Template>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
          <Panel>
            <Border Name="PART_Line" Width="1" HorizontalAlignment="Center" Background="{TemplateBinding BorderBrush}" />
            <Border Name="PART_Highlight" Width="1" HorizontalAlignment="Center" Margin="2,0,0,0"
                    Background="{DynamicResource EnyoItemTopBorderBrush}" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
    <!-- A horizontal splitter (rows) turns the lines. -->
    <Style Selector="^[ResizeDirection=Rows] /template/ Border#PART_Line">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Height" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^[ResizeDirection=Rows] /template/ Border#PART_Highlight">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Line">
      <Setter Property="Background" Value="{DynamicResource EnyoFocusRingBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
