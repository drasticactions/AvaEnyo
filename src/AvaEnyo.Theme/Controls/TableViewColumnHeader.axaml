<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:enyo="https://github.com/avaenyo"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20" Background="{DynamicResource EnyoHeaderBackgroundBrush}">
      <TableViewColumnHeader Content="Header" />
    </Border>
  </Design.PreviewWith>

  <!-- A 1 px header-colored groove between columns that doubles as the resize grip. -->
  <ControlTemplate x:Key="EnyoTableViewColumnHeaderResizerTemplate" TargetType="Thumb">
    <Border Background="Transparent">
      <Rectangle Width="1" Fill="{DynamicResource EnyoHeaderBottomEdgeBrush}" HorizontalAlignment="Center" />
    </Border>
  </ControlTemplate>

  <!-- Invented: column captions in the Enyo label style (14 px, uppercase) in the header text color. -->
  <ControlTheme x:Key="{x:Type TableViewColumnHeader}" TargetType="TableViewColumnHeader">
    <Setter Property="Foreground" Value="{DynamicResource EnyoHeaderForegroundBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource EnyoTextLabelFontSize}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            Padding="{TemplateBinding Padding}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
          <Thumb Name="PART_Resizer"
                 Template="{StaticResource EnyoTableViewColumnHeaderResizerTemplate}"
                 Width="12"
                 HorizontalAlignment="Right"
                 Cursor="SizeWestEast"
                 Margin="0,-6,-6,-6"
                 IsEnabled="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Column?.CanUserEffectivelyResize, FallbackValue=False}" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter > TextBlock">
      <Setter Property="enyo:TextTransform.Uppercase" Value="True" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
