<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:enyo="https://github.com/avaenyo"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <StackPanel Margin="20" Spacing="10">
      <ToggleSwitch />
      <ToggleSwitch IsChecked="True" />
      <ToggleSwitch Content="Header" OnContent="Yes" OffContent="No" />
      <ToggleSwitch IsEnabled="False" IsChecked="True" />
    </StackPanel>
  </Design.PreviewWith>

  <!--
    toggle-button.png, rows on / off / disabled on / disabled off, side slices 8 and 30. On: a blue gradient bar
    with the knob on the right and the ON label on the left. Off: a grey bar with the knob on the left and the OFF
    label on the right. Labels are 14 px bold white uppercase (ToggleButton.css). The knob moves at once, as in Enyo.
    PART_SwitchKnob and PART_MovingKnobs exist for the control's code but take no space: ToggleSwitchGestures gives
    the whole bar Enyo's input (tap, a 15 px drag, a flick).
  -->
  <ControlTheme x:Key="{x:Type ToggleSwitch}" TargetType="ToggleSwitch">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource EnyoTextBrush}" />
    <Setter Property="OnContent" Value="On" />
    <Setter Property="OffContent" Value="Off" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="OnContentTemplate">
      <DataTemplate x:DataType="x:Object">
        <TextBlock Text="{Binding}" enyo:TextTransform.Uppercase="True" />
      </DataTemplate>
    </Setter>
    <Setter Property="OffContentTemplate">
      <DataTemplate x:DataType="x:Object">
        <TextBlock Text="{Binding}" enyo:TextTransform.Uppercase="True" />
      </DataTemplate>
    </Setter>
    <Setter Property="KnobTransitions">
      <Transitions />
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="{TemplateBinding Background}" RowDefinitions="Auto,Auto">
          <ContentPresenter Name="PART_ContentPresenter"
                            Grid.Row="0"
                            Margin="0,0,0,6"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            RecognizesAccessKey="True" />
          <Panel Name="SwitchAreaGrid"
                 Grid.Row="1"
                 Width="{DynamicResource EnyoToggleMinWidth}"
                 Height="{DynamicResource EnyoToggleHeight}"
                 HorizontalAlignment="Left"
                 TemplatedControl.IsTemplateFocusTarget="True">
            <Border Name="OuterBorder"
                    Background="{DynamicResource EnyoToggleOffBrush}"
                    CornerRadius="{DynamicResource EnyoToggleCornerRadius}" />
            <Border Name="SwitchKnobBounds"
                    Background="{DynamicResource EnyoToggleOnBrush}"
                    CornerRadius="{DynamicResource EnyoToggleCornerRadius}"
                    Opacity="0" />
            <ContentPresenter Name="PART_OnContentPresenter"
                              Margin="{DynamicResource EnyoToggleOnLabelMargin}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding OnContent}"
                              ContentTemplate="{TemplateBinding OnContentTemplate}"
                              Foreground="{DynamicResource EnyoToggleForegroundBrush}"
                              FontSize="{DynamicResource EnyoToggleFontSize}"
                              FontWeight="Bold"
                              IsHitTestVisible="False" />
            <ContentPresenter Name="PART_OffContentPresenter"
                              Margin="{DynamicResource EnyoToggleOffLabelMargin}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding OffContent}"
                              ContentTemplate="{TemplateBinding OffContentTemplate}"
                              Foreground="{DynamicResource EnyoToggleForegroundBrush}"
                              FontSize="{DynamicResource EnyoToggleFontSize}"
                              FontWeight="Bold"
                              IsHitTestVisible="False" />
            <Border Name="Knob"
                    Width="{DynamicResource EnyoToggleKnobWidth}"
                    Margin="1"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource EnyoToggleKnobBrush}"
                    BorderBrush="{DynamicResource EnyoToggleKnobEdgeBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource EnyoToggleCornerRadius}"
                    IsHitTestVisible="False" />
            <Canvas Name="PART_SwitchKnob" Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Top">
              <Panel Name="PART_MovingKnobs" Width="0" Height="0" />
            </Canvas>
          </Panel>
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter:empty">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:checked">
      <Style Selector="^ /template/ Border#SwitchKnobBounds">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^ /template/ Border#Knob">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Background" Value="{DynamicResource EnyoToggleKnobOnBrush}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_OffContentPresenter">
        <Setter Property="IsVisible" Value="False" />
      </Style>
    </Style>
    <Style Selector="^:unchecked /template/ ContentPresenter#PART_OnContentPresenter">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:indeterminate /template/ ContentPresenter#PART_OnContentPresenter">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#OuterBorder">
      <Setter Property="BorderBrush" Value="{DynamicResource EnyoFocusRingBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="^:disabled">
      <Style Selector="^ /template/ Panel#SwitchAreaGrid">
        <Setter Property="Opacity" Value="0.5" />
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>
