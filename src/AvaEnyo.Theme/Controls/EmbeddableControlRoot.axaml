<!-- Derived from Avalonia.Themes.Fluent/Controls/EmbeddableControlRoot.xaml (MIT, see NOTICE.md). -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <!-- The browser and mobile root: the Onyx body. -->
  <ControlTheme x:Key="{x:Type EmbeddableControlRoot}" TargetType="EmbeddableControlRoot">
    <Setter Property="Foreground" Value="{DynamicResource EnyoTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource EnyoBodyBrush}" />
    <Setter Property="TopLevel.SystemBarColor" Value="{DynamicResource EnyoToolbarBackgroundBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource EnyoBaseFontSize}" />
    <Setter Property="FontFamily" Value="{DynamicResource EnyoFontFamily}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_TransparencyFallback" IsHitTestVisible="False" />
          <Border Background="{TemplateBinding Background}">
            <VisualLayerManager Name="PART_VisualLayerManager">
              <ContentPresenter Name="PART_ContentPresenter"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Content="{TemplateBinding Content}"
                                Margin="{TemplateBinding Padding}" />
            </VisualLayerManager>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
