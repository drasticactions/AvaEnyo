<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <SelectableTextBlock Margin="20" Text="Selectable text" />
  </Design.PreviewWith>

  <MenuFlyout x:Key="EnyoSelectableTextBlockContextFlyout">
    <MenuItem Header="Copy" Command="{Binding $parent[SelectableTextBlock].Copy}" IsEnabled="{Binding $parent[SelectableTextBlock].CanCopy}" InputGesture="{x:Static TextBox.CopyGesture}" />
  </MenuFlyout>

  <!-- Body text with the Onyx blue selection. -->
  <ControlTheme x:Key="{x:Type SelectableTextBlock}" TargetType="SelectableTextBlock">
    <Setter Property="SelectionBrush" Value="{DynamicResource EnyoInputSelectionBrush}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Style Selector="^[IsEnabled=True]">
      <Setter Property="Cursor" Value="IBeam" />
      <Setter Property="ContextFlyout" Value="{StaticResource EnyoSelectableTextBlockContextFlyout}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
