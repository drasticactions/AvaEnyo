<!-- Derived from Avalonia.Themes.Fluent/Controls/Window.xaml (MIT, see NOTICE.md). -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:enyo="https://github.com/avaenyo"
                    x:ClassModifier="internal">
  <!-- theme.css body: #d8d8d8, #333, 20 px Prelude -->
  <ControlTheme x:Key="{x:Type Window}" TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource EnyoBodyBrush}" />
    <Setter Property="TransparencyBackgroundFallback" Value="{DynamicResource EnyoBodyBrush}" />
    <Setter Property="TopLevel.SystemBarColor" Value="{DynamicResource EnyoToolbarBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource EnyoTextBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource EnyoBaseFontSize}" />
    <Setter Property="FontFamily" Value="{DynamicResource EnyoFontFamily}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_TransparencyFallback" IsHitTestVisible="False" />
          <Border Name="PART_Background" Background="{TemplateBinding Background}" IsHitTestVisible="False" />
          <Panel Background="Transparent" Margin="{TemplateBinding WindowDecorationMargin}" />
          <VisualLayerManager Name="PART_VisualLayerManager">
            <ContentPresenter Name="PART_ContentPresenter"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Content="{TemplateBinding Content}"
                              Margin="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </VisualLayerManager>
          <!--
            The Enyo bar where the system draws the caption buttons (macOS): as tall as the native title bar, the app
            name after the traffic lights, the title in the middle. Empty bar drags the window.
          -->
          <Panel Name="PART_NativeCaptionBar"
                 VerticalAlignment="Top"
                 Height="{Binding WindowDecorationMargin.Top, RelativeSource={RelativeSource TemplatedParent}}"
                 Background="{DynamicResource EnyoWindowCaptionBackgroundBrush}"
                 TextElement.Foreground="{DynamicResource EnyoWindowCaptionForegroundBrush}"
                 TextElement.FontSize="{DynamicResource EnyoWindowCaptionFontSize}"
                 WindowDecorationProperties.ElementRole="TitleBar">
            <enyo:CaptionBarPanel>
              <Button Name="PART_NativeCaptionAppMenuButton"
                      Margin="72,0,0,0"
                      HorizontalAlignment="Left"
                      Theme="{DynamicResource EnyoDrawnAppMenuButton}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <TextBlock Text="{TemplateBinding enyo:EnyoWindow.AppName}" VerticalAlignment="Center" />
                  <Path Data="{DynamicResource EnyoGlyphMenuArrow}"
                        Fill="{Binding $parent[Button].Foreground}"
                        Width="9" Height="6" Stretch="Fill"
                        VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <TextBlock Name="PART_NativeCaptionAppNameText"
                         Text="{TemplateBinding enyo:EnyoWindow.AppName}"
                         Margin="84,0,12,0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False" />
              <TextBlock Name="PART_NativeCaptionTitleText"
                         Text="{TemplateBinding Title}"
                         Margin="12,0"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         IsHitTestVisible="False" />
            </enyo:CaptionBarPanel>
          </Panel>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!--
      Enyo decorations: the content and its overlays start below the status bar, and the background leaves the drawn
      shadow and frame alone.
    -->
    <Style Selector="^[(enyo|EnyoWindow.UseEnyoDecorations)=True] /template/ VisualLayerManager#PART_VisualLayerManager">
      <Setter Property="Margin" Value="{TemplateBinding WindowDecorationMargin}" />
    </Style>
    <Style Selector="^[(enyo|EnyoWindow.UseEnyoDecorations)=True] /template/ Border#PART_Background">
      <Setter Property="Margin" Value="{TemplateBinding WindowDecorationMargin}" />
    </Style>
    <Style Selector="^[(enyo|EnyoWindow.UseEnyoDecorations)=True] /template/ Border#PART_TransparencyFallback">
      <Setter Property="Margin" Value="{TemplateBinding WindowDecorationMargin}" />
    </Style>

    <Style Selector="^ /template/ Panel#PART_NativeCaptionBar">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^[(enyo|EnyoWindow.UsesNativeCaptionButtons)=True] /template/ Panel#PART_NativeCaptionBar">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^ /template/ Button#PART_NativeCaptionAppMenuButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^[(enyo|EnyoWindow.HasAppMenu)=True] /template/ Button#PART_NativeCaptionAppMenuButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^[(enyo|EnyoWindow.HasAppMenu)=True] /template/ TextBlock#PART_NativeCaptionAppNameText">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^[IsActive=False] /template/ Panel#PART_NativeCaptionBar">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource EnyoWindowCaptionInactiveForegroundBrush}" />
    </Style>
    <Style Selector="^[IsActive=False] /template/ Button#PART_NativeCaptionAppMenuButton:not(:pointerover)">
      <Setter Property="Foreground" Value="{DynamicResource EnyoWindowCaptionInactiveForegroundBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
