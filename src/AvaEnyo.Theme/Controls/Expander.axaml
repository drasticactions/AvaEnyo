<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <StackPanel Width="360" Margin="20">
      <Expander Header="Favorites" IsExpanded="True">
        <TextBlock Margin="10" Text="Drawer content" />
      </Expander>
      <Expander Header="Archive">
        <TextBlock Margin="10" Text="Hidden" />
      </Expander>
    </StackPanel>
  </Design.PreviewWith>

  <!--
    DividerDrawer.css: the header is a Divider (Divider.css: 12 pt bold #3a8bcb caption, then the 4 px blue rule of
    divider.png) ending in the collapsible knob of divider-arrow.png: a white disc with a blue ring on the rule and a
    blue triangle that points right when closed and down when open. Tapping the header toggles. The content opens
    in 250 ms and closes in 100 ms with a cubic ease-out height animation (ExpanderMotion).
  -->
  <ControlTheme x:Key="EnyoDividerDrawerHeaderTheme" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource EnyoDividerCaptionBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource EnyoDividerFontSize}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Name="ToggleButtonGrid"
              Background="{TemplateBinding Background}"
              ColumnDefinitions="Auto,*,Auto">
          <ContentPresenter Name="PART_ContentPresenter"
                            Grid.Column="0"
                            Margin="{DynamicResource EnyoDividerCaptionMargin}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
          <Border Name="PART_Rule"
                  Grid.Column="1"
                  Height="{DynamicResource EnyoDividerRuleHeight}"
                  MinWidth="3"
                  VerticalAlignment="Center"
                  Background="{DynamicResource EnyoDividerRuleBrush}" />
          <Panel Name="ExpandCollapseChevronBorder"
                 Grid.Column="2"
                 Width="{DynamicResource EnyoDividerArrowWidth}"
                 Height="{DynamicResource EnyoDividerArrowHeight}">
            <Border Height="{DynamicResource EnyoDividerRuleHeight}"
                    VerticalAlignment="Center"
                    Background="{DynamicResource EnyoDividerRuleBrush}" />
            <Ellipse Name="PART_Knob"
                     Width="{DynamicResource EnyoDividerKnobSize}"
                     Height="{DynamicResource EnyoDividerKnobSize}"
                     Fill="{DynamicResource EnyoDividerArrowFillBrush}"
                     Stroke="{DynamicResource EnyoDividerArrowBrush}"
                     StrokeThickness="2.5" />
            <Path Name="ExpandCollapseChevron"
                  Data="{DynamicResource EnyoGlyphDividerArrow}"
                  Fill="{DynamicResource EnyoDividerArrowBrush}"
                  Width="13"
                  Height="13"
                  Stretch="Uniform"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  RenderTransformOrigin="50%,50%"
                  RenderTransform="rotate(0deg)">
              <Path.Transitions>
                <Transitions>
                  <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
                </Transitions>
              </Path.Transitions>
            </Path>
          </Panel>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked /template/ Path#ExpandCollapseChevron">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>
    <!-- divider-arrow.png down states: the disc darkens -->
    <Style Selector="^:pressed /template/ Ellipse#PART_Knob">
      <Setter Property="Fill" Value="{DynamicResource EnyoPillDownBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Ellipse#PART_Knob">
      <Setter Property="Stroke" Value="{DynamicResource EnyoFocusRingBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type Expander}" TargetType="Expander">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel MinWidth="{TemplateBinding MinWidth}" MaxWidth="{TemplateBinding MaxWidth}">
          <ToggleButton Name="ExpanderHeader"
                        Theme="{StaticResource EnyoDividerDrawerHeaderTheme}"
                        DockPanel.Dock="Top"
                        Margin="{DynamicResource EnyoDividerMargin}"
                        IsEnabled="{TemplateBinding IsEnabled}"
                        Content="{TemplateBinding Header}"
                        ContentTemplate="{TemplateBinding HeaderTemplate}"
                        IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" />
          <Border Name="ExpanderContent"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Top"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </DockPanel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:up /template/ ToggleButton#ExpanderHeader">
      <Setter Property="DockPanel.Dock" Value="Bottom" />
    </Style>
    <Style Selector="^:left /template/ ToggleButton#ExpanderHeader">
      <Setter Property="DockPanel.Dock" Value="Right" />
    </Style>
    <Style Selector="^:right /template/ ToggleButton#ExpanderHeader">
      <Setter Property="DockPanel.Dock" Value="Left" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
