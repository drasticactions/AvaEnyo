<!-- Derived from Avalonia.Themes.Fluent/Controls/AdornerLayer.xaml (MIT, see NOTICE.md). -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <!-- Invented: Enyo had no keyboard focus ring. A 2 px Onyx blue rounded ring. -->
  <ControlTheme x:Key="{x:Type AdornerLayer}" TargetType="AdornerLayer">
    <Setter Property="DefaultFocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="2"
                CornerRadius="5"
                BorderBrush="{DynamicResource EnyoFocusRingBrush}"
                Margin="-1" />
      </FocusAdornerTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
