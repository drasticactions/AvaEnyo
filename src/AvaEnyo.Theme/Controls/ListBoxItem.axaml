<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <ListBox Width="240">
      <ListBoxItem>First</ListBoxItem>
      <ListBoxItem IsSelected="True">Selected</ListBoxItem>
      <ListBoxItem IsEnabled="False">Disabled</ListBoxItem>
    </ListBox>
  </Design.PreviewWith>

  <!--
    Item.css enyo-item: padding 10, .9rem, a 1 px rgba(255,255,255,.5) top edge and a 1 px rgba(0,0,0,.2) bottom
    edge. enyo-held / enyo-item-selected: the blue gradient, shown at once on press. No hover look.
  -->
  <ControlTheme x:Key="{x:Type ListBoxItem}" TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource EnyoTextBrush}" />
    <Setter Property="Padding" Value="{DynamicResource EnyoItemPadding}" />
    <Setter Property="FontSize" Value="{DynamicResource EnyoItemFontSize}" />
    <Setter Property="MinHeight" Value="{DynamicResource EnyoItemMinHeight}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Name="PART_LayoutRoot">
          <Border Name="PART_Background"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
          <Border Name="PART_HeldBorder"
                  Background="{DynamicResource EnyoItemHeldBrush}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  IsVisible="False" />
          <Border Name="PART_TopEdge"
                  VerticalAlignment="Top"
                  Height="1"
                  Background="{DynamicResource EnyoItemTopBorderBrush}" />
          <Border Name="PART_BottomEdge"
                  VerticalAlignment="Bottom"
                  Height="1"
                  Background="{DynamicResource EnyoItemBottomBorderBrush}" />
          <ContentPresenter Name="PART_ContentPresenter"
                            Foreground="{TemplateBinding Foreground}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Content="{TemplateBinding Content}"
                            Padding="{TemplateBinding Padding}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pressed /template/ Border#PART_HeldBorder">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:selected /template/ Border#PART_HeldBorder">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Background" Value="{DynamicResource EnyoItemSelectedBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <!-- enyo-first / enyo-last: no top edge on the first row, no bottom edge on the last. -->
    <Style Selector="^:nth-child(1) /template/ Border#PART_TopEdge">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:nth-last-child(1) /template/ Border#PART_BottomEdge">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
