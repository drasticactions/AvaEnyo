<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <StackPanel Width="380" Margin="20">
      <NotificationCard Content="New mail from Rowan" />
    </StackPanel>
  </Design.PreviewWith>

  <!--
    The webOS dashboard: a dark bar with white text at the bottom of the screen. It slides up into place in 350 ms
    (the Toaster timing) and slides off to the right when it closes, as a dashboard swiped away. A 4 px strip at the
    left edge shows the kind: blue information, green success, amber warning, red error.
  -->
  <ControlTheme x:Key="{x:Type NotificationCard}" TargetType="NotificationCard">
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Width" Value="360" />
    <Setter Property="MinHeight" Value="{DynamicResource EnyoDashboardHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource EnyoPopupFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource EnyoDashboardForegroundBrush}" />
    <Setter Property="RenderTransformOrigin" Value="50%,100%" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{DynamicResource EnyoDashboardBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource EnyoButtonCornerRadius}" />
    <Setter Property="Template">
      <ControlTemplate>
        <LayoutTransformControl Name="PART_LayoutTransformControl" UseRenderTransform="True">
          <Border CornerRadius="{TemplateBinding CornerRadius}" BoxShadow="{DynamicResource EnyoPopupShadow}" Margin="6,4,6,8">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    MinHeight="{TemplateBinding MinHeight}"
                    ClipToBounds="True">
              <DockPanel>
                <Panel Name="PART_HeaderBar" Width="4" Background="{DynamicResource EnyoButtonGrayBackgroundBrush}" DockPanel.Dock="Left" />
                <Border Height="1" VerticalAlignment="Top" DockPanel.Dock="Top" Background="{DynamicResource EnyoToolbarHighlightBrush}" />
                <ContentPresenter Name="PART_ContentPresenter"
                                  VerticalAlignment="Center"
                                  Content="{TemplateBinding Content}" />
              </DockPanel>
            </Border>
          </Border>
        </LayoutTransformControl>
      </ControlTemplate>
    </Setter>
    <ControlTheme.Animations>
      <Animation Duration="0:0:0.35" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="40" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </ControlTheme.Animations>
    <Style Selector="^[IsClosing=true] /template/ LayoutTransformControl#PART_LayoutTransformControl">
      <Style.Animations>
        <Animation Duration="0:0:0.35" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="TranslateTransform.X" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="TranslateTransform.X" Value="800" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="^[IsClosing=true]">
      <Style.Animations>
        <Animation Duration="0:0:0.4" FillMode="Forward">
          <KeyFrame Cue="100%">
            <Setter Property="IsClosed" Value="True" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="^:information /template/ Panel#PART_HeaderBar">
      <Setter Property="Background" Value="{DynamicResource EnyoButtonBlueBackgroundBrush}" />
    </Style>
    <Style Selector="^:success /template/ Panel#PART_HeaderBar">
      <Setter Property="Background" Value="{DynamicResource EnyoButtonAffirmativeBackgroundBrush}" />
    </Style>
    <Style Selector="^:warning /template/ Panel#PART_HeaderBar">
      <Setter Property="Background" Value="{DynamicResource EnyoButtonNotificationAlternateBackgroundBrush}" />
    </Style>
    <Style Selector="^:error /template/ Panel#PART_HeaderBar">
      <Setter Property="Background" Value="{DynamicResource EnyoButtonNegativeBackgroundBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
