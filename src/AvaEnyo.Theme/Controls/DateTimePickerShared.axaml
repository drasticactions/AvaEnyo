<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20" Width="220" Background="{DynamicResource EnyoPopupBackgroundBrush}">
      <StackPanel Spacing="10">
        <ListBoxItem Theme="{DynamicResource EnyoDateTimePickerItem}">Standard item</ListBoxItem>
        <ListBoxItem Theme="{DynamicResource EnyoDateTimePickerItem}" IsSelected="True">Selected item</ListBoxItem>
        <Panel Height="52">
          <Border Theme="{DynamicResource EnyoPickerPillHighlight}" />
          <Border Theme="{DynamicResource EnyoPickerPill}" />
          <TextBlock Text="Pill" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Panel>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!--
    picker-pill.png, 10px slice: a translucent white sheen over the background, a 1 px dark edge and a 1 px white
    highlight below it. The sprite keeps about 8 px of transparent margin above and below, 5 px at the sides.
  -->
  <ControlTheme x:Key="EnyoPickerPill" TargetType="Border">
    <Setter Property="Margin" Value="5,8,5,7" />
    <Setter Property="Background" Value="{DynamicResource EnyoPillSheenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EnyoPillEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource EnyoPickerPillCornerRadius}" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </ControlTheme>

  <!-- The white highlight line under a pill (the last row of picker-pill.png). -->
  <ControlTheme x:Key="EnyoPickerPillHighlight" TargetType="Border">
    <Setter Property="Margin" Value="5,8,5,6" />
    <Setter Property="BorderBrush" Value="{DynamicResource EnyoPillHighlightBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="{DynamicResource EnyoPickerPillCornerRadius}" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </ControlTheme>

  <!-- PopupList rows (enyo-picker-item): plain rows; the selected row is bold on white (enyo-picker-item-selected). -->
  <ControlTheme x:Key="EnyoDateTimePickerItem" TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource EnyoPopupForegroundBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource EnyoPickerFontSize}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          Foreground="{TemplateBinding Foreground}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource EnyoItemHeldBrush}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="^.MonthItem">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,0,8,0" />
    </Style>
  </ControlTheme>

  <!-- Invented: the up and down repeat buttons of a selector column, shown on hover. A chevron on the popup fill. -->
  <ControlTheme x:Key="EnyoDateTimePickerUpButton" TargetType="RepeatButton">
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Background" Value="{DynamicResource EnyoPopupBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource EnyoChevronBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <Path Data="{DynamicResource EnyoGlyphChevronUp}" Fill="{TemplateBinding Foreground}"
                Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource EnyoItemHeldBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="EnyoDateTimePickerDownButton" TargetType="RepeatButton" BasedOn="{StaticResource EnyoDateTimePickerUpButton}">
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <Path Data="{DynamicResource EnyoGlyphChevronDown}" Fill="{TemplateBinding Foreground}"
                Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!--
    The button that holds the field pills of a DatePicker or TimePicker. It draws no frame of its own: the pills are
    the look, as an Enyo DatePicker was a row of PickerButtons. Pressed: picker-pill-downstate.png.
  -->
  <ControlTheme x:Key="EnyoDateTimePickerFlyoutButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinHeight" Value="{DynamicResource EnyoPickerPillHeight}" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          Content="{TemplateBinding Content}"
                          Foreground="{TemplateBinding Foreground}"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Stretch" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
