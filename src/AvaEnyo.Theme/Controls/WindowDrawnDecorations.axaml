<!-- Derived from Avalonia.Themes.Fluent/Controls/WindowDrawnDecorations.xaml (MIT, see NOTICE.md). -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:enyo="https://github.com/avaenyo"
                    x:ClassModifier="internal">

  <!--
    Invented: a caption button on the status bar. Transparent until hovered; close turns the negative red, as
    Windows caption buttons do.
  -->
  <ControlTheme x:Key="EnyoDrawnCaptionButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource EnyoWindowCaptionForegroundBrush}" />
    <Setter Property="Width" Value="{DynamicResource EnyoWindowCaptionButtonWidth}" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="(WindowDecorationProperties.ElementRole)" Value="DecorationsElement" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          Foreground="{TemplateBinding Foreground}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          Content="{TemplateBinding Content}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource EnyoWindowCaptionButtonHoverBrush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource EnyoWindowCaptionButtonPressedBrush}" />
    </Style>
    <Style Selector="^.close:pointerover, ^.close:pressed">
      <Setter Property="Background" Value="{DynamicResource EnyoButtonNegativeBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource EnyoButtonVariantForegroundBrush}" />
    </Style>
  </ControlTheme>

  <!-- The app name and ▾ at the left of the status bar, which opened the webOS app menu. -->
  <ControlTheme x:Key="EnyoDrawnAppMenuButton" TargetType="Button" BasedOn="{StaticResource EnyoDrawnCaptionButton}">
    <Setter Property="Width" Value="NaN" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="enyo:EnyoWindow.OpensAppMenu" Value="True" />
  </ControlTheme>

  <!--
    Invented: the window caption is the TouchPad status bar: black, the app name at the left (with a ▾ when the
    window has an app menu), the window title in the middle, caption buttons at the right.
  -->
  <ControlTheme x:Key="{x:Type WindowDrawnDecorations}" TargetType="WindowDrawnDecorations">
    <Setter Property="DefaultTitleBarHeight" Value="{DynamicResource EnyoWindowCaptionHeight}" />
    <Setter Property="DefaultFrameThickness" Value="1" />
    <Setter Property="DefaultShadowThickness" Value="8" />
    <Setter Property="enyo:EnyoWindow.MirrorsWindow" Value="True" />
    <Setter Property="Template">
      <WindowDrawnDecorationsTemplate>
        <WindowDrawnDecorationsContent>

          <WindowDrawnDecorationsContent.Underlay>
            <Panel Name="PART_UnderlayWrapper">
              <Border Name="PART_WindowBorder"
                      Background="Transparent"
                      BorderThickness="{TemplateBinding FrameThickness}"
                      BorderBrush="{DynamicResource EnyoWindowCaptionBackgroundBrush}"
                      IsHitTestVisible="False" />
              <!-- Titlebar: background and drag area live in the underlay -->
              <Panel Name="PART_TitleBar"
                     VerticalAlignment="Top"
                     Height="{TemplateBinding TitleBarHeight}"
                     Background="{DynamicResource EnyoWindowCaptionBackgroundBrush}"
                     IsVisible="{TemplateBinding HasTitleBar}"
                     WindowDecorationProperties.ElementRole="TitleBar" />
            </Panel>
          </WindowDrawnDecorationsContent.Underlay>

          <WindowDrawnDecorationsContent.Overlay>
            <Panel Name="PART_OverlayWrapper">
              <!-- The window's background covers the underlay, so the bar paints here; drags fall through to PART_TitleBar. -->
              <Border Name="PART_TitleBarBackground"
                      VerticalAlignment="Top"
                      Height="{TemplateBinding TitleBarHeight}"
                      Background="{DynamicResource EnyoWindowCaptionBackgroundBrush}"
                      IsVisible="{TemplateBinding HasTitleBar}"
                      IsHitTestVisible="False" />
              <Grid Name="PART_CaptionPanel"
                    VerticalAlignment="Top"
                    Height="{TemplateBinding TitleBarHeight}"
                    IsVisible="{TemplateBinding HasTitleBar}"
                    ColumnDefinitions="Auto,*,Auto"
                    TextElement.Foreground="{DynamicResource EnyoWindowCaptionForegroundBrush}"
                    TextElement.FontSize="{DynamicResource EnyoWindowCaptionFontSize}">
                <Button Name="PART_AppMenuButton"
                        Theme="{StaticResource EnyoDrawnAppMenuButton}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="{TemplateBinding enyo:EnyoWindow.AppName}" VerticalAlignment="Center" />
                    <Path Data="{DynamicResource EnyoGlyphMenuArrow}"
                          Fill="{Binding $parent[Button].Foreground}"
                          Width="9" Height="6" Stretch="Fill"
                          VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <TextBlock Name="PART_AppNameText"
                           Text="{TemplateBinding enyo:EnyoWindow.AppName}"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
                <TextBlock Name="PART_TitleText"
                           Grid.Column="1"
                           Text="{TemplateBinding Title}"
                           Margin="12,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False" />
                <StackPanel Name="PART_OverlayPanel" Grid.Column="2" Orientation="Horizontal">
                  <Button Name="PART_FullScreenButton"
                          Theme="{StaticResource EnyoDrawnCaptionButton}"
                          WindowDecorationProperties.ElementRole="FullScreenButton">
                    <Viewbox Width="11" Margin="2">
                      <Path Stretch="UniformToFill"
                            Fill="{Binding $parent[Button].Foreground}"
                            Data="M2048 2048v-819h-205v469l-1493 -1493h469v-205h-819v819h205v-469l1493 1493h-469v205h819z" />
                    </Viewbox>
                  </Button>
                  <Button Name="PART_MinimizeButton"
                          Theme="{StaticResource EnyoDrawnCaptionButton}"
                          WindowDecorationProperties.ElementRole="MinimizeButton">
                    <PathIcon Data="{DynamicResource EnyoGlyphMinimize}" Width="14" Height="14" />
                  </Button>
                  <Button Name="PART_MaximizeButton"
                          Theme="{StaticResource EnyoDrawnCaptionButton}"
                          WindowDecorationProperties.ElementRole="MaximizeButton">
                    <PathIcon Name="RestoreButtonPath" Data="{DynamicResource EnyoGlyphMaximize}" Width="14" Height="14" />
                  </Button>
                  <Button Name="PART_CloseButton"
                          Classes="close"
                          Theme="{StaticResource EnyoDrawnCaptionButton}"
                          WindowDecorationProperties.ElementRole="CloseButton">
                    <PathIcon Data="{DynamicResource EnyoGlyphClose}" Width="14" Height="14" />
                  </Button>
                </StackPanel>
              </Grid>
            </Panel>
          </WindowDrawnDecorationsContent.Overlay>

          <WindowDrawnDecorationsContent.FullscreenPopover>
            <Grid Height="{TemplateBinding DefaultTitleBarHeight}"
                  VerticalAlignment="Top"
                  ColumnDefinitions="*,Auto"
                  Background="{DynamicResource EnyoWindowCaptionBackgroundBrush}"
                  TextElement.Foreground="{DynamicResource EnyoWindowCaptionForegroundBrush}"
                  TextElement.FontSize="{DynamicResource EnyoWindowCaptionFontSize}"
                  WindowDecorationProperties.ElementRole="DecorationsElement">
              <TextBlock Text="{TemplateBinding Title}"
                         Margin="12,0"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Name="PART_PopoverFullScreenButton"
                        Theme="{StaticResource EnyoDrawnCaptionButton}"
                        WindowDecorationProperties.ElementRole="FullScreenButton">
                  <Viewbox Width="11" Margin="2">
                    <Path Stretch="UniformToFill"
                          Fill="{Binding $parent[Button].Foreground}"
                          Data="M205 1024h819v-819h-205v469l-674 -674l-145 145l674 674h-469v205zM1374 1229h469v-205h-819v819h205v-469l674 674l145 -145z" />
                  </Viewbox>
                </Button>
                <Button Name="PART_PopoverCloseButton"
                        Classes="close"
                        Theme="{StaticResource EnyoDrawnCaptionButton}"
                        WindowDecorationProperties.ElementRole="CloseButton">
                  <PathIcon Data="{DynamicResource EnyoGlyphClose}" Width="14" Height="14" />
                </Button>
              </StackPanel>
            </Grid>
          </WindowDrawnDecorationsContent.FullscreenPopover>

        </WindowDrawnDecorationsContent>
      </WindowDrawnDecorationsTemplate>
    </Setter>

    <Style Selector="^:has-shadow /template/ Panel#PART_UnderlayWrapper">
      <Setter Property="Margin" Value="{TemplateBinding ShadowThickness}" />
    </Style>
    <Style Selector="^:has-shadow /template/ Border#PART_WindowBorder">
      <Setter Property="BoxShadow" Value="{DynamicResource EnyoPopupShadow}" />
    </Style>
    <Style Selector="^:has-shadow /template/ Panel#PART_OverlayWrapper">
      <Setter Property="Margin" Value="{TemplateBinding ShadowThickness}" />
    </Style>
    <Style Selector="^:has-border /template/ Panel#PART_TitleBar">
      <Setter Property="Margin" Value="1,1,1,0" />
    </Style>
    <Style Selector="^:has-border /template/ Border#PART_TitleBarBackground">
      <Setter Property="Margin" Value="1,1,1,0" />
    </Style>
    <Style Selector="^:has-border /template/ Grid#PART_CaptionPanel">
      <Setter Property="Margin" Value="1,1,1,0" />
    </Style>
    <Style Selector="^ /template/ Button#PART_AppMenuButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^[(enyo|EnyoWindow.HasAppMenu)=True] /template/ Button#PART_AppMenuButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^[(enyo|EnyoWindow.HasAppMenu)=True] /template/ TextBlock#PART_AppNameText">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^[(enyo|EnyoWindow.IsWindowActive)=False] /template/ Grid#PART_CaptionPanel">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource EnyoWindowCaptionInactiveForegroundBrush}" />
    </Style>
    <Style Selector="^[(enyo|EnyoWindow.IsWindowActive)=False] /template/ Button:not(:pointerover)">
      <Setter Property="Foreground" Value="{DynamicResource EnyoWindowCaptionInactiveForegroundBrush}" />
    </Style>
    <Style Selector="^:maximized /template/ PathIcon#RestoreButtonPath">
      <Setter Property="Data" Value="{DynamicResource EnyoGlyphRestore}" />
    </Style>
    <Style Selector="^ /template/ Button:disabled">
      <Setter Property="Opacity" Value="0.2" />
    </Style>
    <Style Selector="^:not(:has-minimize) /template/ Button#PART_MinimizeButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:not(:has-maximize) /template/ Button#PART_MaximizeButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:not(:has-fullscreen) /template/ Button#PART_FullScreenButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:not(:has-fullscreen) /template/ Button#PART_PopoverFullScreenButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:fullscreen /template/ Grid#PART_CaptionPanel">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:fullscreen /template/ Border#PART_TitleBarBackground">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:fullscreen /template/ Panel#PART_TitleBar">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
