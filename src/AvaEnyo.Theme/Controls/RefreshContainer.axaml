<!-- Derived from Avalonia.Themes.Fluent/Controls/RefreshContainer.xaml (MIT, see NOTICE.md). -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <RefreshContainer Width="200" Height="200">
      <TextBlock Text="Pull to refresh" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </RefreshContainer>
  </Design.PreviewWith>

  <!-- Invented: a plain host; the refresh knob comes from the RefreshVisualizer theme. -->
  <ControlTheme x:Key="{x:Type RefreshContainer}" TargetType="RefreshContainer">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Content="{TemplateBinding Content}"
                            Padding="{TemplateBinding Padding}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
          <Grid Name="PART_RefreshVisualizerPresenter" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
