<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20">
      <Calendar />
    </Border>
  </Design.PreviewWith>

  <!-- Invented: Enyo had no calendar. An Onyx group (group-unlabeled.png edge, radius 10) on the body color. -->
  <ControlTheme x:Key="{x:Type Calendar}" TargetType="Calendar">
    <Setter Property="Foreground" Value="{DynamicResource EnyoTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource EnyoBodyBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EnyoGroupEdgeBrush}" />
    <Setter Property="HeaderBackground" Value="{DynamicResource EnyoHeaderBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource EnyoGroupCornerRadius}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource EnyoPickerFontSize}" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Name="PART_Root" HorizontalAlignment="Center" ClipToBounds="True">
          <CalendarItem Name="PART_CalendarItem"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        HeaderBackground="{TemplateBinding HeaderBackground}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
