<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20" Width="600">
      <CommandBar>
        <CommandBarButton Label="New">
          <CommandBarButton.Icon>
            <PathIcon Data="{DynamicResource EnyoGlyphPlus}" />
          </CommandBarButton.Icon>
        </CommandBarButton>
        <CommandBarSeparator />
        <CommandBarToggleButton Label="Search" IsChecked="True">
          <CommandBarToggleButton.Icon>
            <PathIcon Data="{DynamicResource EnyoGlyphSearch}" />
          </CommandBarToggleButton.Icon>
        </CommandBarToggleButton>
      </CommandBar>
    </Border>
  </Design.PreviewWith>

  <!--
    ToolButton.css: transparent until pressed; pressed (and checked) is button-toolbar.png, 4px slice, radius 5: a
    dark translucent sheen with a 1 px edge. Text is #f2f2f2, 16 px.
  -->
  <ControlTheme x:Key="EnyoCommandBarButtonBase" TargetType="Button">
    <!-- Foreground is inherited from the command bar, so a light toolbar gets dark tool text. -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource EnyoButtonCornerRadius}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Margin" Value="{DynamicResource EnyoButtonMargin}" />
    <Setter Property="MinWidth" Value="{DynamicResource EnyoButtonMinHeight}" />
    <Setter Property="MinHeight" Value="{DynamicResource EnyoButtonMinHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource EnyoButtonFontSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource EnyoToolButtonSheenBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EnyoToolButtonEdgeBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </ControlTheme>

  <!-- The overflow ("more") tool button of the command bar. -->
  <ControlTheme x:Key="EnyoCommandBarOverflowButton" TargetType="Button" BasedOn="{StaticResource EnyoCommandBarButtonBase}">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Content="{TemplateBinding Content}"
                          Foreground="{TemplateBinding Foreground}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type CommandBarButton}" TargetType="CommandBarButton" BasedOn="{StaticResource EnyoCommandBarButtonBase}">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <StackPanel Name="PART_LayoutRoot" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ContentPresenter Name="PART_IconPresenter"
                              Content="{TemplateBinding Icon}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center" />
            <TextBlock Name="PART_Label"
                       Text="{TemplateBinding Label}"
                       Foreground="{TemplateBinding Foreground}"
                       FontSize="{DynamicResource EnyoToolTipFontSize}"
                       HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^[IsCompact=True] /template/ TextBlock#PART_Label">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^[LabelPosition=Right] /template/ StackPanel#PART_LayoutRoot">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="6" />
    </Style>
    <Style Selector="^[LabelPosition=Right] /template/ ContentPresenter#PART_IconPresenter">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^[LabelPosition=Right] /template/ TextBlock#PART_Label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{DynamicResource EnyoButtonFontSize}" />
    </Style>
    <!-- In the overflow menu: a MenuItem row on the light menu frame. -->
    <Style Selector="^[IsInOverflow=True]">
      <Setter Property="Foreground" Value="{DynamicResource EnyoPopupForegroundBrush}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="{DynamicResource EnyoMenuItemPadding}" />
    </Style>
    <Style Selector="^[IsInOverflow=True]:pressed">
      <Setter Property="Background" Value="{DynamicResource EnyoItemHeldBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^[IsInOverflow=True] /template/ StackPanel#PART_LayoutRoot">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="10" />
    </Style>
    <Style Selector="^[IsInOverflow=True] /template/ ContentPresenter#PART_IconPresenter">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^[IsInOverflow=True] /template/ TextBlock#PART_Label">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="FontSize" Value="{DynamicResource EnyoMenuItemFontSize}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </ControlTheme>

  <!-- A checked tool toggle keeps the pressed frame (enyo-button-depressed). -->
  <ControlTheme x:Key="{x:Type CommandBarToggleButton}" TargetType="CommandBarToggleButton" BasedOn="{StaticResource EnyoCommandBarButtonBase}">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <StackPanel Name="PART_LayoutRoot" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ContentPresenter Name="PART_IconPresenter"
                              Content="{TemplateBinding Icon}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center" />
            <TextBlock Name="PART_Label"
                       Text="{TemplateBinding Label}"
                       Foreground="{TemplateBinding Foreground}"
                       FontSize="{DynamicResource EnyoToolTipFontSize}"
                       HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{DynamicResource EnyoToolButtonSheenBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EnyoToolButtonEdgeBrush}" />
    </Style>
    <Style Selector="^[IsCompact=True] /template/ TextBlock#PART_Label">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^[LabelPosition=Right] /template/ StackPanel#PART_LayoutRoot">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="6" />
    </Style>
    <Style Selector="^[LabelPosition=Right] /template/ ContentPresenter#PART_IconPresenter">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^[LabelPosition=Right] /template/ TextBlock#PART_Label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{DynamicResource EnyoButtonFontSize}" />
    </Style>
    <Style Selector="^[IsInOverflow=True]">
      <Setter Property="Foreground" Value="{DynamicResource EnyoPopupForegroundBrush}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="{DynamicResource EnyoMenuItemPadding}" />
    </Style>
    <Style Selector="^[IsInOverflow=True]:pressed, ^[IsInOverflow=True]:checked">
      <Setter Property="Background" Value="{DynamicResource EnyoItemSelectedBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^[IsInOverflow=True] /template/ StackPanel#PART_LayoutRoot">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="10" />
    </Style>
    <Style Selector="^[IsInOverflow=True] /template/ ContentPresenter#PART_IconPresenter">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^[IsInOverflow=True] /template/ TextBlock#PART_Label">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="FontSize" Value="{DynamicResource EnyoMenuItemFontSize}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </ControlTheme>

  <!-- Invented: a 1 px groove (dark line with a light line beside it) in the toolbar language. -->
  <ControlTheme x:Key="{x:Type CommandBarSeparator}" TargetType="CommandBarSeparator">
    <Setter Property="Width" Value="2" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Margin" Value="6,8" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border BorderBrush="{DynamicResource EnyoToolbarHighlightBrush}"
                BorderThickness="0,0,1,0"
                Background="{DynamicResource EnyoToolbarShadeBrush}"
                Width="{TemplateBinding Width}"
                Height="{TemplateBinding Height}"
                MinHeight="{TemplateBinding MinHeight}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^[IsInOverflow=True]">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Height" Value="2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border BorderBrush="{DynamicResource EnyoItemTopBorderBrush}"
                  BorderThickness="0,0,0,1"
                  Background="{DynamicResource EnyoItemBottomBorderBrush}"
                  Height="{TemplateBinding Height}" />
        </ControlTemplate>
      </Setter>
    </Style>
  </ControlTheme>

  <!--
    toolbar.png, 2/4px slice: #343434 with a faint white sheen, a 1 px light top line, min height 54. Background
    tints it. The overflow popup is menu-background.png (20px slice, a light grey gradient with a soft shadow).
  -->
  <ControlTheme x:Key="{x:Type CommandBar}" TargetType="CommandBar">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource EnyoToolbarBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource EnyoToolbarForegroundBrush}" />
    <Setter Property="MinHeight" Value="{DynamicResource EnyoToolbarMinHeight}" />
    <Setter Property="Padding" Value="{DynamicResource EnyoToolbarFrame}" />
    <Setter Property="ItemWidthBottom" Value="70" />
    <Setter Property="ItemWidthRight" Value="102" />
    <Setter Property="ItemWidthCollapsed" Value="42" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel MinHeight="{TemplateBinding MinHeight}">
          <Border Name="PART_Background" Background="{TemplateBinding Background}" />
          <Border Name="PART_Sheen"
                  Background="{DynamicResource EnyoToolbarSheenBrush}"
                  BorderBrush="{DynamicResource EnyoToolbarHighlightBrush}"
                  BorderThickness="0,1,0,0" />
          <Border Padding="{TemplateBinding Padding}">
            <Panel>
              <DockPanel KeyboardNavigation.TabNavigation="Cycle">
                <Button Name="PART_OverflowButton"
                        Theme="{StaticResource EnyoCommandBarOverflowButton}"
                        DockPanel.Dock="Right"
                        IsVisible="{TemplateBinding IsOverflowButtonVisible}">
                  <PathIcon Width="20" Height="20"
                            Foreground="{TemplateBinding Foreground}"
                            Data="{DynamicResource EnyoGlyphMore}" />
                </Button>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  Foreground="{TemplateBinding Foreground}"
                                  DockPanel.Dock="Left"
                                  VerticalAlignment="Center" />
                <ItemsControl Name="PART_PrimaryCommands"
                              ItemsSource="{Binding VisiblePrimaryCommands, RelativeSource={RelativeSource TemplatedParent}}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Stretch"
                              ClipToBounds="True">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </DockPanel>

              <Popup Name="PART_OverflowPopup"
                     IsOpen="{TemplateBinding IsOpen, Mode=TwoWay}"
                     PlacementTarget="{Binding #PART_OverflowButton}"
                     Placement="BottomEdgeAlignedRight"
                     IsLightDismissEnabled="True"
                     WindowManagerAddShadowHint="False">
                <Border Margin="8"
                        Background="{DynamicResource EnyoMenuBackgroundBrush}"
                        BorderBrush="{DynamicResource EnyoMenuEdgeBrush}"
                        BorderThickness="1"
                        BoxShadow="{DynamicResource EnyoMenuShadow}"
                        CornerRadius="{DynamicResource EnyoMenuCornerRadius}"
                        Padding="0,6"
                        MinWidth="180"
                        ClipToBounds="True">
                  <ItemsControl Name="PART_OverflowPresenter"
                                ItemsSource="{Binding OverflowItems, RelativeSource={RelativeSource TemplatedParent}}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </Border>
              </Popup>
            </Panel>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <!-- enyo-toolbar-light: #a9a9a9 with toolbar-light.png, dark text. -->
    <Style Selector="^.light">
      <Setter Property="Background" Value="{DynamicResource EnyoToolbarLightBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource EnyoToolbarLightForegroundBrush}" />
      <Style Selector="^ /template/ Border#PART_Sheen">
        <Setter Property="Background" Value="{DynamicResource EnyoToolbarLightSheenBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource EnyoToolbarLightEdgeBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>
