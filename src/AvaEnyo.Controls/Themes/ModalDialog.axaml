<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:enyo="https://github.com/avaenyo"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <enyo:ModalDialogPresenter Caption="Delete account?" Margin="20">
      <TextBlock Text="This cannot be undone." TextWrapping="Wrap" />
    </enyo:ModalDialogPresenter>
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type enyo:ModalDialog}" TargetType="enyo:ModalDialog">
    <Setter Property="Template">
      <ControlTemplate>
        <Panel />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!--
    dialog.png, 42/24/24/24 slice: a #f4f4f4 to #cccccc panel 320 px wide, radius ~10, a ~10 px soft shadow. The
    caption sits centered at 1rem, 10 px above the content (.enyo-modaldialog-title).
  -->
  <ControlTheme x:Key="{x:Type enyo:ModalDialogPresenter}" TargetType="enyo:ModalDialogPresenter">
    <Setter Property="Background" Value="{DynamicResource EnyoDialogBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource EnyoPopupForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EnyoPopupEdgeBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource EnyoPopupCornerRadius}" />
    <Setter Property="Padding" Value="{DynamicResource EnyoModalDialogInset}" />
    <Setter Property="Width" Value="{DynamicResource EnyoModalDialogWidth}" />
    <Setter Property="FontSize" Value="{DynamicResource EnyoPopupFontSize}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Frame"
                Margin="{DynamicResource EnyoPopupShadowMargin}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource EnyoPopupShadow}">
          <DockPanel Margin="{TemplateBinding Padding}">
            <TextBlock Name="PART_Caption" DockPanel.Dock="Top"
                       Text="{TemplateBinding Caption}"
                       FontSize="{DynamicResource EnyoModalDialogTitleFontSize}"
                       Margin="{DynamicResource EnyoModalDialogTitleMargin}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       IsVisible="{TemplateBinding Caption, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
