<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:enyo="https://github.com/avaenyo"
                    x:ClassModifier="internal">
  <!-- Scrim.css: black, opacity .65 when dim; transparent variant at full opacity. -->
  <ControlTheme x:Key="{x:Type enyo:Scrim}" TargetType="enyo:Scrim">
    <Setter Property="Background" Value="{DynamicResource EnyoScrimBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Scrim" Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^.transparent">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
