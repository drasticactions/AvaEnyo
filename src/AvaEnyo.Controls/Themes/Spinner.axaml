<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:enyo="https://github.com/avaenyo"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <StackPanel Orientation="Horizontal" Spacing="10" Margin="10">
      <enyo:Spinner IsActive="True" />
      <enyo:Spinner IsActive="True" Classes="large" />
    </StackPanel>
  </Design.PreviewWith>

  <!--
    spinner.png / spinner-large.png: a grey ring with a brighter sweep, turned once a second. Redrawn as a faint full
    ring plus a three-quarter arc. light class: spinner-light.gif.
  -->
  <ControlTheme x:Key="{x:Type enyo:Spinner}" TargetType="enyo:Spinner">
    <Setter Property="Width" Value="{DynamicResource EnyoSpinnerSize}" />
    <Setter Property="Height" Value="{DynamicResource EnyoSpinnerSize}" />
    <Setter Property="Foreground" Value="{DynamicResource EnyoSpinnerBrush}" />
    <Setter Property="StrokeThickness" Value="{DynamicResource EnyoSpinnerStroke}" />
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Name="PART_Ring" Margin="2">
          <Ellipse Stroke="{TemplateBinding Foreground}" StrokeThickness="{TemplateBinding StrokeThickness}" Opacity="0.3" />
          <Arc Stroke="{TemplateBinding Foreground}" StrokeThickness="{TemplateBinding StrokeThickness}"
               StartAngle="200" SweepAngle="250" StrokeLineCap="Round" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:active">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="Width" Value="{DynamicResource EnyoSpinnerLargeSize}" />
      <Setter Property="Height" Value="{DynamicResource EnyoSpinnerLargeSize}" />
      <Setter Property="StrokeThickness" Value="{DynamicResource EnyoSpinnerLargeStroke}" />
    </Style>
    <Style Selector="^.light">
      <Setter Property="Foreground" Value="{DynamicResource EnyoSpinnerLightBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
