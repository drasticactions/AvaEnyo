<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enyo="https://github.com/avaenyo">
  <!-- The unread count bubble of a folder row. -->
  <Style Selector="Border.count">
    <Setter Property="Background" Value="{DynamicResource EnyoBadgeBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinWidth" Value="26" />
    <Setter Property="Height" Value="22" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.count > TextBlock">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Message rows: sender, subject, preview, time. -->
  <Style Selector="TextBlock.sender">
    <Setter Property="FontSize" Value="{DynamicResource EnyoItemFontSize}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.sender.unread">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.time">
    <Setter Property="FontSize" Value="{DynamicResource EnyoTextSubtextFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource EnyoLabelBrush}" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="6,2,0,0" />
  </Style>
  <Style Selector="Ellipse.unread-dot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Fill" Value="{DynamicResource EnyoBadgeBackgroundBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>

  <!-- The reader body. -->
  <Style Selector="SelectableTextBlock.body">
    <Setter Property="FontSize" Value="{DynamicResource EnyoTextBodySmallFontSize}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="24" />
  </Style>

  <!-- Compose field labels. -->
  <Style Selector="TextBlock.field">
    <Setter Property="FontSize" Value="{DynamicResource EnyoTextLabelFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource EnyoLabelBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Width" Value="64" />
    <Setter Property="enyo:TextTransform.Uppercase" Value="True" />
  </Style>
</Styles>
