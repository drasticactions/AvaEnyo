<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enyo="https://github.com/avaenyo"
             x:Class="AvaEnyo.Photos.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <enyo:AvaEnyoTheme />
    <enyo:AvaEnyoControlsTheme />
    <enyo:AvaEnyoServicesTheme />
    <StyleInclude Source="avares://AvaEnyo.Photos/PhotosStyles.axaml" />
  </Application.Styles>
</Application>
