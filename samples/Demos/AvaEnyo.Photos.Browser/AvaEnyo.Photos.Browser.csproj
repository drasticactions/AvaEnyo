<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <AvaEnyoIsLibrary>false</AvaEnyoIsLibrary>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-browser</TargetFramework>
    <RootNamespace>AvaEnyo.Photos.Browser</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- IL2026/IL2045/IL2072/IL2075: linker warnings inside Avalonia's designer support, not ours; IL2121 follows from hiding them. -->
    <NoWarn>$(NoWarn);CS1591;IL2026;IL2045;IL2072;IL2075;IL2121</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AvaEnyo.Photos\AvaEnyo.Photos.csproj" />
  </ItemGroup>

</Project>
