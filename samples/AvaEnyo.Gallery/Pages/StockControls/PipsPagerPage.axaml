<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enyo="https://github.com/avaenyo"
             x:Class="AvaEnyo.Gallery.Pages.StockControls.PipsPagerPage">
  <StackPanel Classes="page">
    <HeaderedContentControl Classes="sample" Header="PipsPager">
      <PipsPager NumberOfPages="6" SelectedPageIndex="2" />
    </HeaderedContentControl>
    <HeaderedContentControl Classes="sample" Header="Vertical">
      <PipsPager NumberOfPages="4" Orientation="Vertical" />
    </HeaderedContentControl>
  </StackPanel>
</UserControl>
