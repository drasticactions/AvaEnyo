<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enyo="https://github.com/avaenyo"
             x:Class="AvaEnyo.Gallery.Pages.StockControls.SplitViewPage">
  <DockPanel>
    <enyo:Toolbar DockPanel.Dock="Top" Classes="light">
      <ToggleButton Name="PaneToggle" Content="Pane" IsChecked="True" />
    </enyo:Toolbar>
    <SplitView IsPaneOpen="{Binding #PaneToggle.IsChecked}" DisplayMode="Inline" OpenPaneLength="240">
      <SplitView.Pane>
        <StackPanel>
          <enyo:Item Content="Inbox" />
          <enyo:Item Content="Sent" />
          <enyo:Item Content="Archive" />
        </StackPanel>
      </SplitView.Pane>
      <TextBlock Margin="16" Text="Content. The pane edge carries the sliding shadow." />
    </SplitView>
  </DockPanel>
</UserControl>
