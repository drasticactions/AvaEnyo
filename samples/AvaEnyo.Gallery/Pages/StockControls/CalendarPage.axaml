<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enyo="https://github.com/avaenyo"
             x:Class="AvaEnyo.Gallery.Pages.StockControls.CalendarPage">
  <StackPanel Classes="page">
    <HeaderedContentControl Classes="sample" Header="Calendar">
      <Calendar HorizontalAlignment="Left" />
    </HeaderedContentControl>
    <HeaderedContentControl Classes="sample" Header="CalendarDatePicker">
      <CalendarDatePicker Width="240" HorizontalAlignment="Left" />
    </HeaderedContentControl>
    <HeaderedContentControl Classes="sample" Header="Year view">
      <Calendar DisplayMode="Year" HorizontalAlignment="Left" />
    </HeaderedContentControl>
  </StackPanel>
</UserControl>
