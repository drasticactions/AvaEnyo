<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enyo="https://github.com/avaenyo"
             x:Class="AvaEnyo.Gallery.Pages.StockControls.AutoCompletePage">
  <StackPanel Classes="page">
    <HeaderedContentControl Classes="sample" Header="AutoCompleteBox">
      <enyo:Group Width="320" HorizontalAlignment="Left">
        <enyo:Item TapHighlight="False"><AutoCompleteBox Name="Fruits" PlaceholderText="Type a fruit" /></enyo:Item>
      </enyo:Group>
    </HeaderedContentControl>
  </StackPanel>
</UserControl>
