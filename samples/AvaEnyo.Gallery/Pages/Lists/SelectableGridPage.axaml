<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enyo="https://github.com/avaenyo"
             x:Class="AvaEnyo.Gallery.Pages.Lists.SelectableGridPage">
  <DockPanel>
    <enyo:Toolbar DockPanel.Dock="Bottom">
      <enyo:ToolButton Name="SelectToggle" Content="Select" IsToggle="True" />
      <enyo:Spacer />
      <TextBlock Name="Count" VerticalAlignment="Center" Foreground="{DynamicResource EnyoToolbarForegroundBrush}" />
    </enyo:Toolbar>
    <enyo:VirtualList Name="Grid" Layout="Grid" ItemWidth="160" ItemHeight="120" />
  </DockPanel>
</UserControl>
