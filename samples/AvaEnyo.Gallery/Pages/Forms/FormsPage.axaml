<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enyo="https://github.com/avaenyo"
             x:Class="AvaEnyo.Gallery.Pages.Forms.FormsPage">
  <!-- The Enyo Sampler page: rows, inputs with accessories, groups and row groups. -->
  <StackPanel Classes="page">
    <enyo:Toolbar>
      <enyo:ToolButton Icon="{DynamicResource EnyoGlyphChevronLeft}" />
      <enyo:ToolButton Icon="{DynamicResource EnyoGlyphRefresh}" />
      <enyo:ToolButton Icon="{DynamicResource EnyoGlyphInfo}" />
      <enyo:ToolButton Icon="{DynamicResource EnyoGlyphChevronRight}" />
    </enyo:Toolbar>

    <enyo:Item TapHighlight="False">
      <DockPanel>
        <ToggleSwitch DockPanel.Dock="Right" />
        <TextBlock Text="Turbo Encabulation" VerticalAlignment="Center" />
      </DockPanel>
    </enyo:Item>
    <enyo:Item TapHighlight="False">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Splat" VerticalAlignment="Center" />
        <CheckBox />
        <TextBlock Text="Flat" VerticalAlignment="Center" Margin="16,0,0,0" />
        <CheckBox />
        <TextBlock Text="Chat" VerticalAlignment="Center" Margin="16,0,0,0" />
        <CheckBox />
      </StackPanel>
    </enyo:Item>
    <enyo:Item TapHighlight="False">
      <DockPanel>
        <TextBlock Text="Modial" VerticalAlignment="Center" Margin="0,0,32,0" />
        <enyo:RadioGroup SelectedIndex="0" HorizontalAlignment="Stretch">
          <enyo:RadioGroup.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
          </enyo:RadioGroup.ItemsPanel>
          <enyo:RadioSegment Content="Rel" />
          <enyo:RadioSegment Content="Dur" />
          <enyo:RadioSegment Content="Cap" />
        </enyo:RadioGroup>
      </DockPanel>
    </enyo:Item>
    <enyo:Item TapHighlight="False">
      <TextBox PlaceholderText="Name" />
    </enyo:Item>
    <enyo:Item TapHighlight="False">
      <enyo:InputBox>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Dmb" Margin="4,-6" />
          <TextBox PlaceholderText="Name" />
        </DockPanel>
      </enyo:InputBox>
    </enyo:Item>
    <enyo:Item TapHighlight="False">
      <enyo:InputBox>
        <DockPanel>
          <Border DockPanel.Dock="Right" Width="40" Height="40" CornerRadius="5" ClipToBounds="True" Margin="4,-8">
            <Image Name="Avatar" Stretch="UniformToFill" />
          </Border>
          <TextBox PlaceholderText="Job Title" />
        </DockPanel>
      </enyo:InputBox>
    </enyo:Item>

    <enyo:Group>
      <enyo:Item TapHighlight="False">
        <DockPanel>
          <TextBlock Text="Modial" VerticalAlignment="Center" Margin="0,0,32,0" />
          <enyo:RadioGroup SelectedIndex="1">
            <enyo:RadioSegment Content="Rel" />
            <enyo:RadioSegment Content="Dur" />
            <enyo:RadioSegment Content="Cap" />
          </enyo:RadioGroup>
        </DockPanel>
      </enyo:Item>
    </enyo:Group>

    <enyo:RowGroup>
      <DockPanel>
        <ComboBox DockPanel.Dock="Right" SelectedIndex="0" Width="110">
          <ComboBoxItem Content="Google" />
          <ComboBoxItem Content="Yahoo" />
          <ComboBoxItem Content="Bing" />
        </ComboBox>
        <TextBox PlaceholderText="Search..." />
      </DockPanel>
    </enyo:RowGroup>

    <enyo:Group>
      <enyo:Item>
        <TextBlock Text="Evacipate memories..." FontStyle="Italic" />
      </enyo:Item>
    </enyo:Group>
    <enyo:Group>
      <enyo:Item>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <PathIcon Data="{DynamicResource EnyoGlyphPlus}" Foreground="{DynamicResource EnyoFootnoteBrush}" />
          <TextBlock Text="Add Grievance" Foreground="{DynamicResource EnyoFootnoteBrush}" />
        </StackPanel>
      </enyo:Item>
    </enyo:Group>

    <enyo:RowGroup>
      <DockPanel>
        <PathIcon DockPanel.Dock="Right" Data="{DynamicResource EnyoGlyphRefresh}" Width="24" Height="24" />
        <TextBox PlaceholderText="With an icon" />
      </DockPanel>
      <TextBox PlaceholderText="Plain" />
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Btn" Margin="4,-6" />
        <TextBox PlaceholderText="With a button" />
      </DockPanel>
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Classes="enyo-label" Text="No go-away hint" VerticalAlignment="Center" />
        <TextBox />
      </DockPanel>
      <TextBox PlaceholderText="Last row" />
    </enyo:RowGroup>

    <enyo:DividerDrawer Caption="Divider">
      <StackPanel>
        <enyo:RowGroup Header="Default web search engine">
          <ComboBox SelectedIndex="0">
            <ComboBoxItem Content="Google" />
            <ComboBoxItem Content="Wikipedia" />
            <ComboBoxItem Content="Bing" />
          </ComboBox>
        </enyo:RowGroup>
        <enyo:PickerGroup Label="integer">
          <enyo:IntegerPicker />
        </enyo:PickerGroup>
        <StackPanel Orientation="Horizontal" Spacing="16">
          <enyo:PickerGroup Label="first">
            <enyo:IntegerPicker Value="1" />
          </enyo:PickerGroup>
          <enyo:PickerGroup Label="city">
            <enyo:Picker SelectedIndex="0" TextAlign="Left">
              <x:String>San Francisco</x:String>
              <x:String>Sunnyvale</x:String>
              <x:String>Oakland</x:String>
              <x:String>Burlingame</x:String>
            </enyo:Picker>
          </enyo:PickerGroup>
        </StackPanel>
      </StackPanel>
    </enyo:DividerDrawer>

    <enyo:RowGroup Header="New account">
      <TextBox PlaceholderText="Username" />
      <TextBox PlaceholderText="Password" PasswordChar="•" />
    </enyo:RowGroup>

    <enyo:Group>
      <enyo:Item TapHighlight="False">
        <StackPanel>
          <Button Content="Button" HorizontalAlignment="Stretch" />
          <enyo:ActivityButton IsActive="True" Content="Activity Button" HorizontalAlignment="Stretch" />
        </StackPanel>
      </enyo:Item>
    </enyo:Group>
  </StackPanel>
</UserControl>
