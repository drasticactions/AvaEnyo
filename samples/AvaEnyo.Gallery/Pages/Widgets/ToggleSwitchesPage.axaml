<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enyo="https://github.com/avaenyo"
             x:Class="AvaEnyo.Gallery.Pages.Widgets.ToggleSwitchesPage">
  <StackPanel Classes="page">
    <HeaderedContentControl Classes="sample" Header="In rows">
      <enyo:Group Header="Settings">
        <enyo:Item TapHighlight="False">
          <DockPanel>
            <ToggleSwitch DockPanel.Dock="Right" IsChecked="True" />
            <TextBlock Text="Turbo encabulation" VerticalAlignment="Center" />
          </DockPanel>
        </enyo:Item>
        <enyo:Item TapHighlight="False">
          <DockPanel>
            <ToggleSwitch DockPanel.Dock="Right" />
            <TextBlock Text="Airplane mode" VerticalAlignment="Center" />
          </DockPanel>
        </enyo:Item>
        <enyo:Item TapHighlight="False">
          <DockPanel>
            <ToggleSwitch DockPanel.Dock="Right" OnContent="Yes" OffContent="No" IsChecked="True" />
            <TextBlock Text="Custom labels" VerticalAlignment="Center" />
          </DockPanel>
        </enyo:Item>
      </enyo:Group>
    </HeaderedContentControl>
    <HeaderedContentControl Classes="sample" Header="Disabled">
      <WrapPanel Classes="row">
        <ToggleSwitch IsEnabled="False" />
        <ToggleSwitch IsEnabled="False" IsChecked="True" />
      </WrapPanel>
    </HeaderedContentControl>
  </StackPanel>
</UserControl>
