<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enyo="https://github.com/avaenyo">
  <!-- A captioned box on a sample page, like the boxes of the Onyx theming sample. -->
  <Style Selector="HeaderedContentControl.sample">
    <Setter Property="Margin" Value="0,0,0,16" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel>
          <enyo:Divider Caption="{TemplateBinding Header}" />
          <ContentPresenter Content="{TemplateBinding Content}" Margin="8,0" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="StackPanel.page">
    <Setter Property="Margin" Value="16" />
    <Setter Property="Spacing" Value="4" />
  </Style>
  <Style Selector="WrapPanel.row > Control">
    <Setter Property="Margin" Value="0,0,6,6" />
  </Style>
  <Style Selector="SelectableTextBlock.code">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
</Styles>
