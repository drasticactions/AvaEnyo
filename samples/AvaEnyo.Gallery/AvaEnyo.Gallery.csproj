<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AvaEnyoIsLibrary>false</AvaEnyoIsLibrary>
    <OutputType>Library</OutputType>
    <RootNamespace>AvaEnyo.Gallery</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- CommunityToolkit.Mvvm 8.4 gates [ObservableProperty] on partial properties behind the preview language version -->
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AvaEnyo.Samples.Common\AvaEnyo.Samples.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Each page shows its own XAML in the source pullout. -->
    <EmbeddedResource Include="Pages\**\*.axaml" LogicalName="src/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
